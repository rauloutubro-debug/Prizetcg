{
  "name": "prizecheck-tcg",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:native": "expo run:android",
    "ios:native": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/domain.test.ts",
    "build:web": "expo export --platform web",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:unsigned": "bash scripts/build-ios-unsigned.sh"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "expo-crypto": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-native-safe-area-context": "~5.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "lucide-react-native": "1.65.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.1.10",
    "tsx": "^4.20.0"
  }
}
